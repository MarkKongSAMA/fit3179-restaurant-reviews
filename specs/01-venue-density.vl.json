{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth: 2024 CLUE cafe/restaurant establishment counts divided by whole small-area square kilometres. Conic equal-area projection centred by rotation on Melbourne. Historical municipal context; not filtered by the review controls.",
  "width": "container",
  "height": 330,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#183b35",
      "titleColor": "#183b35",
      "domainColor": "#bdc9c2",
      "tickColor": "#bdc9c2",
      "gridColor": "#e6ebe5",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#183b35",
      "labelColor": "#183b35",
      "symbolStrokeWidth": 1,
      "padding": 4
    },
    "title": {
      "fontSize": 13,
      "color": "#183b35",
      "anchor": "start",
      "fontWeight": "normal"
    }
  },
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/processed/areas.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "calculate": "datum.properties.density < 10 ? '< 10' : datum.properties.density < 30 ? '10–<30' : datum.properties.density < 100 ? '30–<100' : datum.properties.density < 300 ? '100–<300' : '≥ 300'",
          "as": "density_class"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.9
      },
      "encoding": {
        "color": {
          "field": "density_class",
          "type": "ordinal",
          "title": "Venues / km²",
          "scale": {
            "domain": [
              "< 10",
              "10–<30",
              "30–<100",
              "100–<300",
              "≥ 300"
            ],
            "range": [
              "#f1f3df",
              "#cddfc0",
              "#92bda4",
              "#4d927e",
              "#195c48"
            ]
          },
          "legend": {
            "type": "symbol",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "square",
            "symbolSize": 100,
            "columnPadding": 18,
            "rowPadding": 4,
            "title": "Venues / km²"
          }
        },
        "tooltip": [
          {
            "field": "properties.area",
            "type": "nominal",
            "title": "CLUE area"
          },
          {
            "field": "properties.venue_count",
            "type": "quantitative",
            "title": "2024 establishments",
            "format": ",.0f"
          },
          {
            "field": "properties.area_km2",
            "type": "quantitative",
            "title": "Whole area (km²)",
            "format": ".2f"
          },
          {
            "field": "properties.density",
            "type": "quantitative",
            "title": "Venues / km²",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/processed/areas.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": {
            "field": "properties.area",
            "oneOf": [
              "Melbourne (CBD)",
              "Carlton",
              "Docklands"
            ]
          }
        },
        {
          "calculate": "geoCentroid(null, datum)",
          "as": "label_centroid"
        },
        {
          "calculate": "datum.label_centroid[0]",
          "as": "label_lon"
        },
        {
          "calculate": "datum.label_centroid[1]",
          "as": "label_lat"
        },
        {
          "calculate": "datum.properties.area === 'Melbourne (CBD)' ? 'CBD' : datum.properties.area",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#fffdf7",
        "stroke": "#fffdf7",
        "strokeWidth": 3,
        "strokeOpacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/processed/areas.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": {
            "field": "properties.area",
            "oneOf": [
              "Melbourne (CBD)",
              "Carlton",
              "Docklands"
            ]
          }
        },
        {
          "calculate": "geoCentroid(null, datum)",
          "as": "label_centroid"
        },
        {
          "calculate": "datum.label_centroid[0]",
          "as": "label_lon"
        },
        {
          "calculate": "datum.label_centroid[1]",
          "as": "label_lat"
        },
        {
          "calculate": "datum.properties.area === 'Melbourne (CBD)' ? 'CBD' : datum.properties.area",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#183b35"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
