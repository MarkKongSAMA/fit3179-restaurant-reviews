{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Rating versus cumulative review count for injected sample rows. The logarithmic review axis is fixed while filtering. Drag an interval brush; the host reads the brush signal and filters the map and shortlist, while this view retains the other points for context. Double-click clears the brush.",
  "width": "container",
  "height": 260,
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "background": "transparent",
  "config": {
    "font": "Arial",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#183b35",
      "titleColor": "#183b35",
      "domainColor": "#bdc9c2",
      "tickColor": "#bdc9c2",
      "gridColor": "#e6ebe5",
      "labelPadding": 6,
      "titlePadding": 10
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleColor": "#183b35",
      "labelColor": "#183b35",
      "symbolStrokeWidth": 1,
      "padding": 4
    },
    "title": {
      "fontSize": 13,
      "color": "#183b35",
      "anchor": "start",
      "fontWeight": "normal"
    }
  },
  "data": {
    "name": "reviews",
    "values": []
  },
  "params": [
    {
      "name": "brush",
      "select": {
        "type": "interval",
        "encodings": [
          "x",
          "y"
        ],
        "clear": "dblclick",
        "zoom": false,
        "mark": {
          "fill": "#c5dcd2",
          "fillOpacity": 0.35,
          "stroke": "#28746b"
        }
      }
    }
  ],
  "mark": {
    "type": "point",
    "filled": true,
    "size": 76,
    "stroke": "#ffffff",
    "strokeWidth": 0.7
  },
  "encoding": {
    "x": {
      "field": "review_count",
      "type": "quantitative",
      "title": "Cumulative reviews (log scale)",
      "scale": {
        "type": "log",
        "domain": [
          200,
          7000
        ],
        "nice": false
      },
      "axis": {
        "values": [
          200,
          500,
          1000,
          2000,
          6000
        ],
        "format": "~s"
      }
    },
    "y": {
      "field": "rating",
      "type": "quantitative",
      "title": "Rating / 5 (zoomed)",
      "scale": {
        "domain": [
          4,
          5
        ],
        "zero": false,
        "nice": false
      },
      "axis": {
        "values": [
          4,
          4.2,
          4.4,
          4.6,
          4.8,
          5
        ],
        "format": ".1f"
      }
    },
    "color": {
      "field": "price",
      "type": "nominal",
      "scale": {
        "domain": [
          "Budget",
          "Mid-range",
          "Premium"
        ],
        "range": [
          "#d5a245",
          "#28746b",
          "#a65a3c"
        ]
      },
      "legend": {
        "title": "Price tier",
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "opacity": {
      "condition": {
        "param": "brush",
        "value": 0.95
      },
      "value": 0.18
    },
    "tooltip": [
      {
        "field": "name",
        "type": "nominal",
        "title": "Restaurant"
      },
      {
        "field": "rating",
        "type": "quantitative",
        "title": "Rating / 5",
        "format": ".1f"
      },
      {
        "field": "review_count",
        "type": "quantitative",
        "title": "Cumulative reviews",
        "format": ",.0f"
      },
      {
        "field": "price",
        "type": "nominal",
        "title": "Price tier"
      },
      {
        "field": "source_url",
        "type": "nominal",
        "title": "Listing source"
      }
    ]
  }
}
